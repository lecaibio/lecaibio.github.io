# Build output and caches — all regenerated by `bundle exec jekyll build`.
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Bundler, if it is ever pointed at a local path (`bundle install --path vendor/bundle`).
# _config.yml already excludes vendor/ from Jekyll's own processing.
.bundle/
vendor/

# macOS
.DS_Store

# Editor and tooling config is COMMITTED on purpose, not ignored:
#   .vscode/settings.json  stops VS Code flagging the front matter in assets/main.scss
#   .claude/launch.json    the `jekyll serve` config used to preview the site
# This repo gets cloned onto more than one machine, so both are worth carrying along.
# Only the machine-local variants are ignored:
.claude/settings.local.json
.vscode/settings.local.json

# Dependency versions. GitHub Pages ignores this file and builds with its own pinned set,
# so it only affects local builds. Committing it would make local builds reproducible
# across machines; see DEVELOPMENT.md before changing this line.
Gemfile.lock
